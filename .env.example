# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
ENABLE_AUTO_REPLY=false

# Industry Preset (retail, services, restaurant, support, simple)
INDUSTRY_PRESET=

# Simple Mode (minimal setup, no integrations required)
SIMPLE_MODE=false
STORAGE_TYPE=file

# CRM (choose one)
CRM_TYPE=hubspot
HUBSPOT_API_KEY=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
NOTION_ACCESS_TOKEN=
NOTION_DATABASE_ID=

# Shopify (optional)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# WooCommerce (optional)
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Google Calendar (optional)
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=

# OpenAI (for message analysis)
OPENAI_API_KEY=

# Product Catalog (JSON array for order parsing)
PRODUCT_CATALOG=

# Conversation Summarization
SUMMARY_THRESHOLD=5
SEND_SUMMARY_TO_BUSINESS=false
BUSINESS_PHONE_NUMBER=

# Style Learning (for auto-replies that match your writing style)
STYLE_LEARNING_ENABLED=true

# Storage (optional, defaults to file storage)
STORAGE_PATH=./data
REDIS_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Server
PORT=3000
